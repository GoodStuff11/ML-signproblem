-
-            if length(degen_rm_U) < h_i
-                push!(degen_rm_U,basis_transform*V1[:,perm]*phases)
-            else
-                degen_rm_U[h_i] = hcat(degen_rm_U[h_i],basis_transform*V1[:,perm]*phases)
