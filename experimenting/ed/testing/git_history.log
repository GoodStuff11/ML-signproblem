+                end
+            end
+            indices = [sort(creation_index_list) sort(annihilation_index_list)]'[:]
+
+            for (k,s) in enumerate(variable_mapping)
+                _indices = copy(indices)
+                for (σ_i, σ) in enumerate([:up, :down])
+                    for site in s[σ_i]
+                        push!(_indices,site_indexer[(site, σ)])
