+function merge_count!(arr, temp, left, mid, right)
+    i = left
+    j = mid + 1
+    k = left
+    inv_count = 0
+    
+    while i <= mid && j <= right
+        if arr[i] <= arr[j]
+            temp[k] = arr[i]
+            i += 1
+        else
+            temp[k] = arr[j]
+            inv_count += (mid - i + 1)
